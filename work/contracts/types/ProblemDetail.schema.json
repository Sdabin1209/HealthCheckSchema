{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "category": {
      "$ref": "Problem.schema.json"
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "SlotRef.schema.json"
      }
    },
    "message": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "category",
    "code",
    "refs",
    "message"
  ],
  "additionalProperties": false
}
