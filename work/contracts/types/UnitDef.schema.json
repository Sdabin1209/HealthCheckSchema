{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "range": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "convert_to": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "factor": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit_code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "unit",
            "factor"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "name",
    "synonyms",
    "range",
    "convert_to"
  ],
  "additionalProperties": false
}
