  "oneOf": [
    {
      "type": "string",
      "minLength": 1
    },
    {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "unit_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "additionalProperties": false
    },
    {
      "$ref": "CodedValue.schema.json"
    }
  ]
}
