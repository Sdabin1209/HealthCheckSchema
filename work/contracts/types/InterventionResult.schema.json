{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "$ref": "SessionId.schema.json"
    },
    "result": {
      "oneOf": [
        {
          "const": "APPLIED"
        },
        {
          "const": "IGNORED"
        },
        {
          "const": "FAILED"
        }
      ]
    }
  },
  "required": [
    "session_id",
    "result"
  ],
  "additionalProperties": false
}
